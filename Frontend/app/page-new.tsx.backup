"use client";

import { useState } from "react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import * as z from "zod";
import { motion } from "framer-motion";
import Image from "next/image";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { GoogleDriveInput } from "@/components/google-drive-input";
import { ProgressTracker, GenerationStage } from "@/components/progress-tracker";
import { useToast } from "@/components/ui/use-toast";
import {
  ArrowRight,
  CheckCircle2,
  FileText,
  Zap,
  Shield,
} from "lucide-react";

const formSchema = z.object({
  proposalFolderUrl: z
    .string()
    .url("Please enter a valid URL")
    .refine(
      (url) => url.includes("drive.google.com"),
      "Please enter a valid Google Drive URL"
    ),
  outputFolderUrl: z
    .string()
    .url("Please enter a valid URL")
    .refine(
      (url) => url.includes("drive.google.com"),
      "Please enter a valid Google Drive URL"
    ),
});

type FormData = z.infer<typeof formSchema>;

export default function Home() {
  const [currentStage, setCurrentStage] = useState<GenerationStage>("idle");
  const [progress, setProgress] = useState(0);
  const [generatedSowUrl, setGeneratedSowUrl] = useState<string | null>(null);
  const { toast } = useToast();

  const {
    watch,
    setValue,
    formState: { errors },
    handleSubmit,
  } = useForm<FormData>({
    resolver: zodResolver(formSchema),
    defaultValues: {
      proposalFolderUrl: "",
      outputFolderUrl: "",
    },
  });

  const proposalUrl = watch("proposalFolderUrl");
  const outputUrl = watch("outputFolderUrl");

  const onSubmit = async (data: FormData) => {
    try {
      setCurrentStage("uploading");
      setProgress(10);

      await new Promise((resolve) => setTimeout(resolve, 1500));
      setProgress(25);

      setCurrentStage("extracting");
      setProgress(40);
      await new Promise((resolve) => setTimeout(resolve, 2000));
      setProgress(60);

      setCurrentStage("generating");
      setProgress(75);
      await new Promise((resolve) => setTimeout(resolve, 2500));
      setProgress(95);

      setCurrentStage("complete");
      setProgress(100);

      setGeneratedSowUrl(data.outputFolderUrl + "/generated-sow.docx");

      toast({
        title: "Success",
        description: "Your Statement of Work has been generated successfully.",
      });
    } catch (error) {
      toast({
        title: "Error",
        description: "Failed to generate SOW. Please try again.",
        variant: "destructive",
      });
      setCurrentStage("idle");
      setProgress(0);
    }
  };

  const handleReset = () => {
    setCurrentStage("idle");
    setProgress(0);
    setGeneratedSowUrl(null);
    setValue("proposalFolderUrl", "");
    setValue("outputFolderUrl", "");
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 via-white to-red-50/30">
      {/* Navigation */}
      <nav className="border-b bg-white/80 backdrop-blur-md sticky top-0 z-50">
        <div className="container mx-auto px-4 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-8">
              <Image
                src="/onix-logo.svg"
                alt="Onix"
                width={120}
                height={40}
                priority
              />
              <div className="hidden md:flex items-center gap-6">
                <a href="#" className="text-sm font-medium hover:text-primary transition-colors">
                  Home
                </a>
                <a href="#features" className="text-sm font-medium text-gray-600 hover:text-primary transition-colors">
                  Features
                </a>
                <a href="#" className="text-sm font-medium text-gray-600 hover:text-primary transition-colors">
                  About
                </a>
              </div>
            </div>
            <Button variant="outline" size="sm">
              Contact Us
            </Button>
          </div>
        </div>
      </nav>

      {/* Hero Section */}
      <section className="container mx-auto px-4 pt-20 pb-12">
        <div className="grid lg:grid-cols-2 gap-12 items-center">
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.6 }}
          >
            <h1 className="text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
              Automate Your
              <span className="text-primary block">SOW Generation</span>
            </h1>
            <p className="text-xl text-gray-600 mb-8 leading-relaxed">
              Transform your business proposals into professional Statements of Work in minutes.
              Powered by advanced AI technology for accuracy and efficiency.
            </p>
            <div className="flex flex-wrap gap-4">
              <Button
                size="lg"
                className="primary-gradient text-white px-8"
                onClick={() => document.getElementById('generator')?.scrollIntoView({ behavior: 'smooth' })}
              >
                Get Started
                <ArrowRight className="ml-2 h-5 w-5" />
              </Button>
              <Button size="lg" variant="outline">
                Learn More
              </Button>
            </div>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.6, delay: 0.2 }}
            className="relative"
          >
            <div className="relative rounded-2xl overflow-hidden shadow-2xl">
              <Image
                src="/images/Business (1).jpg"
                alt="Professional Business"
                width={600}
                height={400}
                className="w-full h-auto object-cover"
              />
              <div className="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
            </div>
          </motion.div>
        </div>
      </section>

      {/* Features Section */}
      <section id="features" className="container mx-auto px-4 py-16">
        <div className="text-center mb-12">
          <h2 className="text-3xl font-bold text-gray-900 mb-4">
            Why Choose Our SOW Generator
          </h2>
          <p className="text-gray-600 max-w-2xl mx-auto">
            Built for modern businesses that value efficiency and precision
          </p>
        </div>

        <div className="grid md:grid-cols-3 gap-8">
          {[
            {
              icon: Zap,
              title: "Lightning Fast",
              description: "Generate comprehensive SOWs in minutes, not hours. Save valuable time for what matters most.",
            },
            {
              icon: Shield,
              title: "Secure & Reliable",
              description: "Your data is protected with enterprise-grade security. Full compliance with industry standards.",
            },
            {
              icon: FileText,
              title: "Professional Output",
              description: "Polished, well-structured documents ready for client presentation. No formatting needed.",
            },
          ].map((feature, index) => (
            <motion.div
              key={index}
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.1 * index }}
            >
              <Card className="border-0 shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
                <CardHeader>
                  <div className="w-12 h-12 rounded-lg primary-gradient flex items-center justify-center mb-4">
                    <feature.icon className="h-6 w-6 text-white" />
                  </div>
                  <CardTitle className="text-xl">{feature.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <p className="text-gray-600">{feature.description}</p>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </div>
      </section>

      {/* Generator Section */}
      <section id="generator" className="container mx-auto px-4 py-16">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="max-w-4xl mx-auto"
        >
          <Card className="border-0 shadow-2xl">
            <CardHeader className="space-y-3 pb-8 bg-gradient-to-br from-gray-50 to-white">
              <CardTitle className="text-3xl font-bold">
                Generate Your Statement of Work
              </CardTitle>
              <CardDescription className="text-base">
                Provide your Google Drive folder links below to begin the automated generation process.
              </CardDescription>
            </CardHeader>

            <CardContent className="pt-8">
              {currentStage === "idle" && (
                <motion.form
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ duration: 0.4 }}
                  onSubmit={handleSubmit(onSubmit)}
                  className="space-y-6"
                >
                  <GoogleDriveInput
                    label="Proposal Folder URL"
                    placeholder="https://drive.google.com/drive/folders/..."
                    value={proposalUrl}
                    onChange={(value) => setValue("proposalFolderUrl", value)}
                    error={errors.proposalFolderUrl?.message}
                    description="Link to the Google Drive folder containing your proposal documents"
                  />

                  <GoogleDriveInput
                    label="Output Folder URL"
                    placeholder="https://drive.google.com/drive/folders/..."
                    value={outputUrl}
                    onChange={(value) => setValue("outputFolderUrl", value)}
                    error={errors.outputFolderUrl?.message}
                    description="Link to the Google Drive folder where the SOW will be saved"
                  />

                  <Button
                    type="submit"
                    size="lg"
                    className="w-full h-14 text-lg font-semibold primary-gradient text-white shadow-lg hover:shadow-xl transition-all duration-300"
                  >
                    Generate Statement of Work
                    <ArrowRight className="ml-2 h-5 w-5" />
                  </Button>
                </motion.form>
              )}

              {currentStage !== "idle" && currentStage !== "complete" && (
                <ProgressTracker
                  currentStage={currentStage}
                  progress={progress}
                />
              )}

              {currentStage === "complete" && generatedSowUrl && (
                <motion.div
                  initial={{ opacity: 0, scale: 0.95 }}
                  animate={{ opacity: 1, scale: 1 }}
                  transition={{ duration: 0.5 }}
                  className="space-y-6"
                >
                  <div className="flex flex-col items-center justify-center py-8 space-y-4">
                    <div className="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center">
                      <CheckCircle2 className="h-10 w-10 text-green-600" />
                    </div>
                    <h3 className="text-2xl font-bold text-gray-900">
                      Generation Complete
                    </h3>
                    <p className="text-gray-600 text-center max-w-md">
                      Your Statement of Work has been successfully generated and saved to your specified Google Drive folder.
                    </p>
                  </div>

                  <div className="flex flex-col sm:flex-row gap-4">
                    <Button
                      size="lg"
                      className="flex-1 h-12 primary-gradient text-white"
                      onClick={() => window.open(generatedSowUrl, "_blank")}
                    >
                      View Generated SOW
                    </Button>
                    <Button
                      size="lg"
                      variant="outline"
                      className="flex-1 h-12"
                      onClick={handleReset}
                    >
                      Generate Another
                    </Button>
                  </div>
                </motion.div>
              )}
            </CardContent>
          </Card>
        </motion.div>
      </section>

      {/* Footer */}
      <footer className="border-t bg-gray-50 mt-20">
        <div className="container mx-auto px-4 py-12">
          <div className="grid md:grid-cols-4 gap-8">
            <div className="space-y-4">
              <Image
                src="/onix-logo.svg"
                alt="Onix"
                width={100}
                height={32}
              />
              <p className="text-sm text-gray-600">
                Transforming business processes with intelligent automation.
              </p>
            </div>
            <div>
              <h4 className="font-semibold mb-4">Product</h4>
              <ul className="space-y-2 text-sm text-gray-600">
                <li><a href="#" className="hover:text-primary transition-colors">Features</a></li>
                <li><a href="#" className="hover:text-primary transition-colors">Pricing</a></li>
                <li><a href="#" className="hover:text-primary transition-colors">Documentation</a></li>
              </ul>
            </div>
            <div>
              <h4 className="font-semibold mb-4">Company</h4>
              <ul className="space-y-2 text-sm text-gray-600">
                <li><a href="#" className="hover:text-primary transition-colors">About</a></li>
                <li><a href="#" className="hover:text-primary transition-colors">Blog</a></li>
                <li><a href="#" className="hover:text-primary transition-colors">Careers</a></li>
              </ul>
            </div>
            <div>
              <h4 className="font-semibold mb-4">Legal</h4>
              <ul className="space-y-2 text-sm text-gray-600">
                <li><a href="#" className="hover:text-primary transition-colors">Privacy</a></li>
                <li><a href="#" className="hover:text-primary transition-colors">Terms</a></li>
                <li><a href="#" className="hover:text-primary transition-colors">Security</a></li>
              </ul>
            </div>
          </div>
          <div className="border-t mt-8 pt-8 text-center text-sm text-gray-600">
            <p>&copy; 2024 Onix. All rights reserved.</p>
          </div>
        </div>
      </footer>
    </div>
  );
}
