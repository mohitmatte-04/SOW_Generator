# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# Model Configuration
DEFAULT_MODEL=gemini-3-flash-preview
REASONING_MODEL=gemini-3.1-pro-preview

# SOW Template Configuration
SOW_TEMPLATE_GCS_URI=gs://your-bucket/templates/sow_template.docx

# Agent Engine Configuration
AGENT_ENGINE_URI=your-agent-engine-uri
ARTIFACT_SERVICE_URI=gs://your-artifact-bucket

# Server Configuration
HOST=0.0.0.0
PORT=8080
SERVE_WEB_INTERFACE=true
RELOAD_AGENTS=true
AGENT_NAME=sow_generator
ALLOWED_ORIGINS=["*"]
LOG_LEVEL=INFO
